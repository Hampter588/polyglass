{
  "schemaVersion": 1,
  "id": "polyglass",
  "version": "${version}",
  "name": "Polyglass",
  "description": "Graphics backend selector for Minecraft 26.2: pick Vulkan, OpenGL or Direct3D 12 (via DirectXMod) from one menu, with an automatic fallback chain.",
  "authors": [
    "Hampter588"
  ],
  "contact": {
    "sources": "https://github.com/Hampter588/polyglass",
    "issues": "https://github.com/Hampter588/polyglass/issues"
  },
  "license": "MIT",
  "icon": "assets/polyglass/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.polyglass.Polyglass"
    ]
  },
  "mixins": [
    "polyglass.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~26.2",
    "java": ">=25"
  },
  "recommends": {
    "gl4dx12": ">=0.1.0"
  }
}
